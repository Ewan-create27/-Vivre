# Neon, Supabase Postgres, Render Postgres, etc.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required in production for permanent photos and videos.
# Create a free Cloudinary account and copy its CLOUDINARY_URL here.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Required only for the "mot de passe oublié" flow.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=À vivre <noreply@your-domain.com>
